DATABASE_URL=postgres://postgres:password@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
AUTH_SECRET=replace_me
AUTH_EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
AUTH_EMAIL_FROM=Fitnest <no-reply@fitnest.ma>
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Local Supabase only: copy values printed by `supabase status`.
# The project URL and anon key are public identifiers, never server secrets.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_local_anon_key
# Server only. Never prefix with NEXT_PUBLIC_, send to a client, or commit a value.
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key
# DATABASE_URL above is a placeholder. Use the local database for development/tests.
# Do not reuse production credentials in CI, fixtures, or preview deployments.

