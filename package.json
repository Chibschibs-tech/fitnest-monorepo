{
  "name": "fitnest-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "test": "vitest run",
    "test:core": "vitest run packages/core",
    "typecheck:core": "tsc --noEmit -p packages/core/tsconfig.json",
    "build": "pnpm --filter my-v0-project build",
    "dev:web": "pnpm -C apps/web dev -p 3002",
    "dev": "pnpm -C apps/web dev -p 3002",
    "docs:generate": "node scripts/generate-docs.js",
    "docs:watch": "nodemon --watch apps/web/app/api --watch packages/db/src --exec 'npm run docs:generate'",
    "postinstall": "npm run docs:generate"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "vitest": "5.0.5",
    "typescript": "5.9.3",
    "@types/node": "24.19.2"
  }
}

